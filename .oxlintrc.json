{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["./oxlint-plugins/basalt-architecture.mjs"],
  "plugins": [
    "typescript",
    "unicorn",
    "react",
    "react-hooks",
    "import",
    "jsx-a11y"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "jsx-a11y/aria-role": "warn",
    // Stale-closure protection — all findings fixed; keep enforced.
    "react-hooks/exhaustive-deps": "error",
    // Architecture enforcement (AGENTS.md four-layer model).
    "basalt/no-cross-feature-imports": "error",
    "basalt/no-upward-layer-imports": "error",
    "basalt/packages-no-tauri": "error",
    // UI policy enforcement (CONVENTIONS §5.3 / ADR-003).
    // All headless primitives must flow through @workspace/ui wrappers;
    // raw <button> must be replaced with shadcn Button.
    "basalt/no-base-ui-imports-in-apps": "error",
    "basalt/no-raw-button-in-apps": "error",
    // Cycle detection via multi-file analysis (project module graph).
    "import/no-cycle": [
      "error",
      {
        "maxDepth": 20
      }
    ],
    // React Compiler rules: project does not use React Compiler yet.
    "react/refs": "off",
    "react/set-state-in-effect": "off",
    "react/preserve-manual-memoization": "off",
    "react/incompatible-library": "off",
    "eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ]
  },
  "ignorePatterns": [
    "crates/**",
    "target/**",
    "**/dist/**",
    "**/.tauri/**",
    "apps/tauri/src/routeTree.gen.ts",
    "packages/theme/src/generated/**"
  ]
}
