{
  "layout": {
    "surfaceMain": "{surface.1}",
    "surfaceRaised": "{surface.2}",
    "surfaceCard": "{surface.3}",
    "border": "{border.default}",
    "divider": "color-mix(in srgb, var(--sat-text-muted) 48%, var(--sat-layout-border))",
    "shadowSm": "{shadow.sm}",
    "shadowMd": "{shadow.md}",
    "shadowLg": "{shadow.lg}",
    "radiusSm": "{radius.sm}",
    "radiusMd": "{radius.md}",
    "radiusLg": "{radius.lg}"
  },
  "editor": {
    "background": "{surface.1}",
    "heading1": "{text.primary}",
    "heading2": "{text.primary}",
    "heading3": "{text.primary}",
    "heading4": "{text.primary}",
    "heading5": "{text.primary}",
    "heading6": "{text.primary}",
    "heading7": "{palette.heading7}",
    "accent": "{accent.primary}",
    "inlineBg": "{palette.codeBg}",
    "hr": "var(--sat-layout-border)",
    "blockquoteBorder": "var(--sat-accent-primary)",
    "blockquoteText": "#cbd5f5",
    "codeBg": "{palette.codeBg}",
    "codeMuted": "{palette.codeMuted}",
    "codeHoverBg": "{palette.codeHoverBg}",
    "codeHoverText": "{palette.codeHoverText}",
    "popoverBg": "{palette.popoverBg}",
    "popoverBorder": "{palette.popoverBorder}",
    "popoverText": "{palette.popoverText}",
    "popoverMuted": "{palette.popoverMuted}",
    "popoverActiveBg": "{palette.popoverActiveBg}",
    "popoverActiveText": "{palette.popoverActiveText}",
    "taskAccent": "{palette.taskAccent}"
  },
  "graph": {
    "background": "{editor.background}",
    "node": "{text.muted}",
    "tag": "{state.success}",
    "attachment": "{text.muted}",
    "edge": "{text.muted}",
    "label": "{text.primary}",
    "hoverFill": "{accent.primary}",
    "hoverRing": "{text.primary}",
    "hoverEdge": "{accent.primary}"
  },
  "syntax": {
    "keyword": "{palette.codeKeyword}",
    "string": "{palette.codeString}",
    "number": "{palette.codeNumber}",
    "comment": "{palette.codeComment}",
    "function": "{palette.codeFunction}",
    "type": "{palette.codeType}",
    "variable": "{palette.codeVariable}",
    "operator": "{palette.codeOperator}",
    "atom": "{palette.codeNumber}",
    "property": "{palette.codeVariable}",
    "tag": "{palette.codeVariable}",
    "attribute": "{palette.codeNumber}",
    "punctuation": "{palette.codeOperator}",
    "regexp": "{palette.codeString}",
    "doc": "{palette.codeComment}",
    "macro": "{palette.codeKeyword}",
    "meta": "{palette.codeComment}",
    "link": "{palette.codeFunction}",
    "changed": "{palette.codeType}",
    "deleted": "{palette.codeVariable}",
    "inserted": "{palette.codeString}"
  },
  "control": {
    "focusRing": "{focus.ring}"
  }
}
