[
  { "key": "CmdOrCtrl+N", "command": "app:new-file" },
  { "key": "CmdOrCtrl+Shift+D", "command": "app:new-drawing" },
  { "key": "CmdOrCtrl+W", "command": "tabs:close-active" },
  { "key": "CmdOrCtrl+F", "command": "editor:find", "when": "editorFocused" },
  { "key": "CmdOrCtrl+Shift+F", "command": "search:open" },
  {
    "key": "CmdOrCtrl+H",
    "command": "editor:replace",
    "when": "editorFocused"
  },
  { "key": "CmdOrCtrl+O", "command": "switcher:open" },
  { "key": "CmdOrCtrl+,", "command": "app:open-settings" },
  { "key": "CmdOrCtrl+G", "command": "graph:open" },
  { "key": "CmdOrCtrl+E", "command": "editor:toggle-view-mode" },
  { "key": "CmdOrCtrl+B", "command": "editor:bold", "when": "editorFocused" },
  { "key": "CmdOrCtrl+I", "command": "editor:italic", "when": "editorFocused" },
  {
    "key": "CmdOrCtrl+A",
    "command": "editor:select-all",
    "when": "editorFocused"
  },
  { "key": "CmdOrCtrl+X", "command": "editor:cut", "when": "editorFocused" },
  { "key": "CmdOrCtrl+C", "command": "editor:copy", "when": "editorFocused" },
  { "key": "CmdOrCtrl+V", "command": "editor:paste", "when": "editorFocused" },
  { "key": "CmdOrCtrl+P", "action": "openCommandPalette" },
  { "key": "CmdOrCtrl+Shift+P", "command": "export:note" },
  { "key": "CmdOrCtrl+S", "action": "saveActiveFile" },
  { "key": "F2", "action": "renameActiveNote" },
  { "key": "Escape", "action": "closeTopModal", "when": "modalOpen" },
  { "key": "CmdOrCtrl+\\", "command": "pane:split-right" },
  { "key": "CmdOrCtrl+Shift+\\", "command": "pane:split-down" },
  { "key": "CmdOrCtrl+Alt+W", "command": "pane:close" },
  {
    "key": "Delete",
    "command": "canvas:delete-selection",
    "when": "canvasFocused"
  },
  {
    "key": "Backspace",
    "command": "canvas:delete-selection",
    "when": "canvasFocused"
  },
  {
    "key": "CmdOrCtrl+Shift+G",
    "command": "canvas:group-selection",
    "when": "canvasFocused"
  },
  { "key": "Alt+ArrowLeft", "command": "tabs:navigate-back" },
  { "key": "Alt+ArrowRight", "command": "tabs:navigate-forward" },
  { "key": "CmdOrCtrl+[", "command": "tabs:navigate-back" },
  { "key": "CmdOrCtrl+]", "command": "tabs:navigate-forward" },
  { "key": "CmdOrCtrl+Alt+ArrowLeft", "command": "tabs:navigate-back" },
  { "key": "CmdOrCtrl+Alt+ArrowRight", "command": "tabs:navigate-forward" }
]
