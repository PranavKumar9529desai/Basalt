{
  "name": "tauri",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:linux": "tauri build",
    "build:linux:deb": "tauri build --bundles deb",
    "build:linux:rpm": "tauri build --bundles rpm",
    "build:linux:appimage": "tauri build --bundles appimage",
    "build:mac:arm": "tauri build --target aarch64-apple-darwin",
    "build:mac:intel": "tauri build --target x86_64-apple-darwin",
    "build:mac": "bun run build:mac:arm && bun run build:mac:intel",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.161.4",
    "@tanstack/react-virtual": "^3.13.18",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2",
    "@workspace/editor": "workspace:*",
    "react": "catalog:default",
    "react-dom": "catalog:default",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.161.4",
    "@tanstack/router-vite-plugin": "^1.161.4",
    "@tauri-apps/cli": "^2",
    "@types/react": "catalog:default",
    "@types/react-dom": "catalog:default",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "tailwindcss": "3.4",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-wasm": "^3.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "jsdom": "^30.0.1",
    "vitest": "^4.1.11"
  }
}
