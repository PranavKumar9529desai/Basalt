{
  "name": "basalt",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "check": "bun run lint && bun run format",
    "clear-cache": "bash scripts/clear-cache.sh"
  },
  "devDependencies": {
    "bun-types": "latest",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "overrides": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6"
  },
  "catalogs": {
    "default": {
      "react": "^19.1.0",
      "react-dom": "^19.1.0",
      "@types/react": "19.1.8",
      "@types/react-dom": "19.1.6",
      "@base-ui/react": "^1.2.0"
    }
  }
}
