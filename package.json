{
  "name": "basalt",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:typed": "oxlint --type-aware",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "format": "oxfmt",
    "check:size": "bun scripts/check-size.ts",
    "check": "bun run lint && bun run format",
    "clear-cache": "bash scripts/clear-cache.sh",
    "build:wasm": "bash scripts/build-graph-wasm.sh && bash scripts/build-frontmatter-wasm.sh",
    "build:wasm:frontmatter": "bash scripts/build-frontmatter-wasm.sh",
    "verify:wasm": "node crates/graph-wasm/verify.mjs"
  },
  "devDependencies": {
    "bun-types": "latest",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "overrides": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6"
  },
  "catalogs": {
    "default": {
      "react": "^19.1.0",
      "react-dom": "^19.1.0",
      "@types/react": "19.1.8",
      "@types/react-dom": "19.1.6",
      "@base-ui/react": "^1.2.0"
    }
  }
}
